#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# eSIM / local secrets — never commit (Firestore app_secrets only)
functions/.esim-secrets.json
**/.esim-secrets.json
.env.secrets
.env
.env.*


# Local Firebase / caches
.firebase/
firebase-debug.log
firebase-debug.*.log

# Android signing (Play upload key — asla commit etme)
android/key.properties
android/*.jks
android/*.keystore
**/*.jks
**/*.keystore

# iOS Codemagic cert private key (asla commit etme)
ios/signing/
**/*.pem
**/*.p12
**/*.p8

# Release binaries
/release/
*.apk
*.aab
*.ipa

# Temp exports
_tmp_*

# Üniversite ham veri (build script çıktısı universities-tr.json commit edilir)
landing/data/raw_*.json

# GAÜN topluluk hesap şifreleri — asla commit etme
scripts/gaun_community_accounts.csv
scripts/gaun_community_accounts.json

