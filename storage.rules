rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function underSize() {
      return request.resource.size < 75 * 1024 * 1024;
    }
    function isMedia() {
      return request.resource.contentType.matches('image/.*')
        || request.resource.contentType.matches('video/.*');
    }
    // Plus ders notu / PDF / Ofis dosyaları
    function isDocument() {
      return request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        || request.resource.contentType == 'application/vnd.ms-powerpoint'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
        || request.resource.contentType == 'application/vnd.ms-excel'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        || request.resource.contentType == 'text/plain'
        || request.resource.contentType == 'application/octet-stream';
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == userId
        && underSize()
        && isMedia();
    }

    match /posts/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == userId
        && underSize()
        && (isMedia() || isDocument());
    }

    match /cv/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == userId
        && underSize()
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    // Öğrenci belgesi — kayıt auth öncesi; getDownloadURL için read şart.
    // Dosya adları rastgele; yalnızca JPEG/PNG/PDF ve 12MB altı.
    match /student_ids/{allPaths=**} {
      allow read: if true;
      allow write: if request.resource.size < 12 * 1024 * 1024
        && (
          request.resource.contentType == 'image/jpeg'
          || request.resource.contentType == 'image/png'
          || request.resource.contentType == 'application/pdf'
        );
    }

    match /ads/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == userId
        && underSize()
        && request.resource.contentType.matches('image/.*');
    }

    match /stories/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == userId
        && underSize()
        && isMedia();
    }

    match /reels/{userId}/{allPaths=**} {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == userId
        && underSize()
        && isMedia();
    }

    // İş ortakları logoları — herkes okur; giriş yapan admin UI’dan yazar.
    match /partners/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn()
        && underSize()
        && request.resource.contentType.matches('image/.*');
    }
  }
}
